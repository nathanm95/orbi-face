{
  "name": "orbi-face",
  "author": "Nathan Marchant",
  "version": "2.0.0",
  "keywords": [
    "pebble-app"
  ],
  "private": true,
  "dependencies": {
    "@rebble/clay": "^1.1.0"
  },
  "pebble": {
