      "LeadingZero",
      "ClockStyle",
      "DateFormat",
      "ShowTemp",
      "BatteryStyle",
      "Live",
      "ActEvery",
      "SaverPct",
      "Quiet",
      "QuietStart",
      "QuietEnd",
      "WakeFlick",
      "WakeTap",
      "WakeRaise",
      "Theme",
      "Props",
      "Seasonal",
      "Hourly",
      "Weather",
      "Fahrenheit",
      "BtAlert",
      "WxCode",
      "WxTemp",
      "WxDay",
      "WxWind",
      "WxRequest"
    ],
    "resources": {
      "media": [
        { "type": "bitmap", "name": "PROP_SUNGLASSES", "file": "images/prop_sunglasses.png" },
        { "type": "bitmap", "name": "PROP_BEANIE", "file": "images/prop_beanie.png" },
        { "type": "bitmap", "name": "PROP_UMBRELLA", "file": "images/prop_umbrella.png" },
        { "type": "bitmap", "name": "PROP_PARTYHAT", "file": "images/prop_partyhat.png" },
        { "type": "bitmap", "name": "PROP_WITCHHAT", "file": "images/prop_witchhat.png" },
        { "type": "bitmap", "name": "PROP_SANTAHAT", "file": "images/prop_santahat.png" },
        { "type": "bitmap", "name": "PROP_NIGHTCAP", "file": "images/prop_nightcap.png" },
        { "type": "bitmap", "name": "PROP_CLOUD", "file": "images/prop_cloud.png" }
      ]
    }
